# InfinityFree + Supabase Configuration
# Copy this file to .env and fill in your credentials

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# INFINITYFREE CONFIGURATION
# ============================================
# InfinityFree is for static hosting only
# All backend logic goes through Supabase

# Base URL for your InfinityFree site
VITE_SITE_URL=https://your-domain.infinityfreeapp.com

# ============================================
# APPLICATION SETTINGS
# ============================================
VITE_APP_NAME=PT. Inti Mutiara Kreasindo
VITE_APP_ENV=production

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features
VITE_ENABLE_EOFFICE=true
VITE_ENABLE_EVENT_REGISTRATION=true
VITE_ENABLE_QR_SCANNER=true
VITE_ENABLE_NOTIFICATIONS=true

# ============================================
# DEMO CREDENTIALS (for testing only)
# ============================================
# These are for demo mode when Supabase is not configured
# In production, use Supabase Auth

DEMO_ADMIN_EMAIL=admin@imk.co.id
DEMO_ADMIN_PASSWORD=admin123

DEMO_MANAGER_EMAIL=manager@imk.co.id
DEMO_MANAGER_PASSWORD=manager123

DEMO_STAFF_EMAIL=staff@imk.co.id
DEMO_STAFF_PASSWORD=staff123

# ============================================
# NOTES
# ============================================
# 1. InfinityFree only supports static files (HTML, CSS, JS)
# 2. All database operations go through Supabase
# 3. Authentication is handled by Supabase Auth
# 4. File uploads go to Supabase Storage
# 5. Real-time features use Supabase Realtime
# 
# DEPLOYMENT STEPS:
# 1. Build the project: npm run build
# 2. Upload contents of 'dist' folder to InfinityFree
# 3. Configure .htaccess for SPA routing (see DEPLOYMENT.md)
# 4. Set up Supabase project and run schema.sql
# 5. Update .env with your Supabase credentials
# 6. Rebuild and redeploy
