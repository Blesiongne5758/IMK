# ============================================
# ENVIRONMENT VARIABLES
# PT. Inti Mutiara Kreasindo - E-Office
# ============================================

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Demo Mode - ONLY enable in development
# Set to 'true' ONLY when developing locally
# NEVER enable in production!
VITE_ENABLE_DEMO=false

# Rate Limiting Configuration
VITE_RATE_LIMIT_MAX_CALLS=10
VITE_RATE_LIMIT_WINDOW_MS=60000

# ============================================
# APPLICATION SETTINGS
# ============================================

VITE_APP_NAME=PT. Inti Mutiara Kreasindo
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Base URL for your site
VITE_SITE_URL=https://your-domain.infinityfreeapp.com

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
VITE_ENABLE_EOFFICE=true
VITE_ENABLE_EVENT_REGISTRATION=true
VITE_ENABLE_QR_SCANNER=true
VITE_ENABLE_NOTIFICATIONS=true

# ============================================
# SECURITY NOTES
# ============================================
# 
# ⚠️ IMPORTANT SECURITY GUIDELINES:
# 
# 1. NEVER commit .env file to version control
# 2. NEVER set VITE_ENABLE_DEMO=true in production
# 3. Use strong, unique passwords for Supabase
# 4. Enable Row Level Security (RLS) on all tables
# 5. Use environment variables for all secrets
# 6. Regularly rotate API keys and credentials
# 7. Monitor access logs for suspicious activity
# 8. Keep dependencies updated
# 
# ============================================
