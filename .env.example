# Supabase Configuration
# Copy this file to .env and fill in your Supabase credentials

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Instructions:
# 1. Create a new project at https://supabase.com
# 2. Go to Project Settings > API
# 3. Copy your Project URL and anon/public key
# 4. Run the SQL schema from supabase/schema.sql in the SQL Editor
# 5. Create users via Authentication > Users or use the demo credentials below

# Demo Credentials (for testing):
# Admin: admin@imk.co.id / admin123
# Manager: manager@imk.co.id / manager123
# Staff: staff@imk.co.id / staff123

# Note: If Supabase is not configured, the app will run in demo mode
# using localStorage for authentication and mock data.
